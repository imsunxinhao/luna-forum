{
  "name": "luna-forum",
  "version": "0.0.0",
  "description": "Luna Forum",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx index.ts",
    "build": "tsc && tscp",
    "build:vercel": "yarn build && yarn install --prod && mkdir -p .vercel/output/functions/index.func && cp -rv dist/* .vercel/output/functions/index.func/ && cp -r node_modules .vercel/output/functions/index.func/node_modules && cp -r package.json .vercel/output/functions/index.func/package.json && cp vercel.opt.json .vercel/output/functions/index.func/.vc-config.json && cp vercel.cfg.json .vercel/output/config.json",
    "dev": "tsx watch index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "build:frontend": "node plugins/frontend/build.mjs"
  },
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@fluentui/web-components": "^3.1.2",
    "@microsoft/fast-element": "^3.0.2",
    "@microsoft/fast-foundation": "^2.50.0",
    "@microsoft/focusgroup-polyfill": "^1.6.0",
    "@prisma/client": "^7.8.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/winston": "^2.4.4",
    "bcrypt": "^6.0.0",
    "fastify": "^5.9.0",
    "i18next": "^26.4.0",
    "iconify-icon": "^3.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.4.0",
    "nunjucks": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pino-pretty": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-cp": "^0.1.11"
  }
}
